# Server (see server/src/config.ts). Copy to .env and adapt.
NODE_ENV=development
HOSTNAME=127.0.0.1
PORT=3000
# memory = no database (everything is lost at restart), postgres = DATABASE_URL required
STORAGE=postgres
DATABASE_URL=postgres://bingo_user:bingo@127.0.0.1:5432/bingo
MIGRATIONS_DIR=migrations
LOG_LEVEL=info
# Production only: public origin, WebSocket upgrades from another origin are refused
# PUBLIC_ORIGIN=https://bingo.voikyrioh.fr
# Built client to serve (empty in development: Vite serves it on :5173)
# STATIC_DIR=../web/dist
