{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		"jsx": "preserve",
		// @Voikyrioh/vue-translate ships TypeScript sources (main: index.ts) that
		// import types without `import type`: checked with our options, they would
		// fail under verbatimModuleSyntax. isolatedModules stays on.
		"verbatimModuleSyntax": false
	},
	"include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
