{
	"name": "@bingo/server",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "STORAGE=${STORAGE:-memory} OTEL_SDK_DISABLED=${OTEL_SDK_DISABLED:-true} tsx watch src/index.ts",
		"build": "node build.mjs",
		"start": "node --enable-source-maps --import @Voikyrioh/observability/register dist/index.js",
		"typecheck": "tsc --noEmit -p .",
		"test": "vitest run"
	},
	"dependencies": {
		"@hono/node-server": "^1.19.17",
		"@hono/node-ws": "^1.3.1",
		"@opentelemetry/api": "^1.9.1",
		"@Voikyrioh/observability": "^0.5.0",
		"hono": "^4.13.13",
		"pg": "^8.23.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@bingo/shared": "*",
		"@types/node": "^22.19.0",
		"@types/pg": "^8.23.1",
		"esbuild": "^0.28.2",
		"pino-pretty": "^13.2.0",
		"tsx": "^4.23.15"
	}
